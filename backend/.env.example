# Backend .env example
# Copy to .env. The parser uses local Ollama models; no cloud API key is required.

# Database
DATABASE_URL=sqlite+aiosqlite:///./extraction.db

# File / artifact storage
UPLOAD_DIR=./uploads
ARTIFACTS_DIR=./artifacts
LANGGRAPH_CHECKPOINT_PATH=./parser_checkpoints.sqlite
MAX_UPLOAD_SIZE_MB=200
MAX_DOCUMENT_PAGES=500
MAX_BATCH_FILES=20
MAX_BATCH_SIZE_MB=1000

# Local Ollama endpoint. Installed models are discovered at runtime and selected in the UI.
OLLAMA_BASE_URL=http://localhost:11434
GLM_OCR_TIMEOUT_SECONDS=600
OLLAMA_REVIEW_TIMEOUT_SECONDS=600

# Official PaddleOCR-VL 1.6 image. Pull it explicitly before starting the backend.
PADDLEOCR_VL_IMAGE=ccr-2vdh3abv-pub.cnc.bj.baidubce.com/paddlepaddle/paddleocr-vl:latest-nvidia-gpu@sha256:ad0b1f056a76967f9191cd06398e8babb21b49a4673a28c3de5fd31f481884db
PADDLEOCR_VL_CACHE_DIR=./.cache/paddleocr-vl
PADDLEOCR_VL_TIMEOUT_SECONDS=600

MAX_PAGE_REPAIRS=2
JOB_SHUTDOWN_GRACE_SECONDS=30

JOB_QUEUE_MAX_DEPTH=50
JOB_TIMEOUT_SECONDS=21600
PARSE_BATCH_PAGES=10
PARSE_BATCH_MAX_ATTEMPTS=2

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Set to require the X-API-Key header on all /api/* routes. Leave empty for
# local single-operator use (default); set it before exposing beyond localhost.
API_KEY=

# Optional vision providers used only for review and targeted repair.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
