# Paperplane V2 — OpenAI-only document extraction
# Optional dotenv fallback. Process/user environment variables with the same names win.
DATABASE_URL=sqlite+aiosqlite:///./document_parser.db
UPLOAD_DIR=./uploads
ARTIFACTS_DIR=./artifacts
MAX_UPLOAD_SIZE_MB=200
MAX_DOCUMENT_PAGES=500

# Required unless set in the OS environment. Keep this server-side.
# Never expose it to the browser.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=180
V2_WORKER_COUNT=4

# Optional operator-supplied prices. Zero means cost reporting is unavailable.
OPENAI_PRICING_VERSION=operator-configured
LUNA_INPUT_PER_MILLION=0
LUNA_CACHED_INPUT_PER_MILLION=0
LUNA_OUTPUT_PER_MILLION=0
TERRA_INPUT_PER_MILLION=0
TERRA_CACHED_INPUT_PER_MILLION=0
TERRA_OUTPUT_PER_MILLION=0

HOST=127.0.0.1
PORT=8000
DEBUG=false
API_KEY=
# Comma-separated exact origins — no wildcard. CORS_ORIGINS=* fails at
# startup whenever CORS_ALLOW_CREDENTIALS=true (the default) or API_KEY is
# set: a wildcard origin combined with credentials or API-key auth lets any
# site's browser script authenticated requests against this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Per-identity request throttling (identity = hash of API_KEY; only meaningful
# once API_KEY is set — disabled callers can't be told apart, see app/rate_limit.py)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
