      "sources": [
        {"path": "paperplane/pipeline.py", "line": 1},
        {"path": "paperplane/grounding.py", "line": 1}
      ]
    },
    {
      "id": "providers",
      "type": "external",
      "label": "Cloud model providers",
      "sublabel": "OpenAI, xAI, Google, Anthropic, or Agnes"
    },
    {
      "id": "assembler",
      "type": "service",
      "label": "Grounded assembler",
